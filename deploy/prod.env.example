# Non-secret production settings for docker-compose.prod.yml. Copy to deploy/prod.env.
# Secrets are NOT set here: they are files in deploy/secrets/ (./deploy/init-secrets.sh).
MONGODB_DATABASE=torpulse
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GEMINI_MODEL=gemini-3-flash-preview
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=torpulse@example.com
NOTIFICATION_FROM=TORPulse <torpulse@example.com>
BMA_SYNC_ENABLED=true
DISCOVERY_SYNC_INTERVAL_MS=600000
QUALIFICATION_DAILY_CALL_LIMIT=200
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_ABSOLUTE_TIMEOUT_MS=604800000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_API_MAX=300
LOG_LEVEL=info
