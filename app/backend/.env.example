PORT=
MONGODB_URI=
MONGODB_DATABASE=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
AI_PROVIDER=deepseek
GEMINI_MODEL=gemini-3-flash-preview
# Set GOOGLE_API_KEY for Vertex AI Express Mode, or use the project/location below with ADC.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true
DISCOVERY_SYNC_INTERVAL_MS=600000
# BMA (egp2.bangkok.go.th) discovery.
BMA_SYNC_ENABLED=true
# BMA_KEYWORDS=ระบบ,โปรแกรม,ซอฟต์แวร์,แอปพลิเคชัน,เว็บไซต์
# BMA_BUDGET_YEAR=2570,2569

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000

# Qualifying-TOR email notifications (notification worker).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From address when the admin has not set a sender email in system settings.
NOTIFICATION_FROM=
NOTIFICATION_POLL_INTERVAL_MS=60000
# Qualification match precompute worker (npm run dev:qualification)
QUALIFICATION_POLL_INTERVAL_MS=10000
QUALIFICATION_SWEEP_INTERVAL_MS=600000
QUALIFICATION_PROFILE_DELAY_MS=300000
QUALIFICATION_DAILY_CALL_LIMIT=200
# Testing only: treat the N latest TORs as open, e.g. 1. Leave empty in production.
QUALIFICATION_TEST_LATEST_TORS=
