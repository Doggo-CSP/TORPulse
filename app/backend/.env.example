PORT=
MONGODB_URI=
MONGODB_DATABASE=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
AI_PROVIDER=deepseek
GEMINI_MODEL=gemini-3-flash-preview
# Set GOOGLE_API_KEY for Vertex AI Express Mode, or use the project/location below with ADC.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
