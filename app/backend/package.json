{
  "name": "doggo",
  "version": "1.0.0",
  "main": "dist/apps/api/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/apps/api/server.ts",
    "build": "tsc",
    "start": "node dist/apps/api/server.js",
    "dev:ingestion": "tsx watch src/apps/ingestion-worker/main.ts",
    "start:ingestion": "node dist/apps/ingestion-worker/main.js",
    "dev:producer": "tsx watch src/apps/queue-producer/main.ts",
    "start:producer": "node dist/apps/queue-producer/main.js",
    "test:queue-upsert": "tsx src/scripts/test-ingestion-queue.ts",
    "test:central-egp": "tsx --test src/modules/ingestion/adapters/central-egp.adapters.test.ts",
    "test:producer": "tsx --test src/modules/ingestion/adapters/govspending-discovery.adapter.test.ts src/apps/queue-producer/queue-producer.test.ts",
    "test:tor": "tsx --test src/modules/tor/tor.model.test.ts src/modules/tor/tor.repository.test.ts src/modules/ingestion/ingestion-job.repository.test.ts src/modules/ingestion/missing-tor-repair.test.ts",
    "test:auth": "tsx --test src/modules/auth/auth.routes.test.ts src/modules/auth/auth.config.test.ts",
    "repair:missing-tors": "tsx src/scripts/repair-missing-tors.ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Doggo-CSP/TORPulse.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Doggo-CSP/TORPulse/issues"
  },
  "homepage": "https://github.com/Doggo-CSP/TORPulse#readme",
  "description": "",
  "dependencies": {
    "@opendataloader/pdf": "^2.5.5",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "fflate": "^0.8.3",
    "mongoose": "^9.9.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.1",
    "@types/node": "^26.1.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  }
}
