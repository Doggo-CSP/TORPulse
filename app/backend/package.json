{
  "name": "doggo",
  "version": "1.0.0",
  "main": "dist/apps/api/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/apps/api/server.ts",
    "build": "tsc",
    "start": "node dist/apps/api/server.js",
    "dev:ingestion": "tsx watch src/apps/ingestion-worker/main.ts",
    "start:ingestion": "node dist/apps/ingestion-worker/main.js",
    "dev:producer": "tsx watch src/apps/queue-producer/main.ts",
    "start:producer": "node dist/apps/queue-producer/main.js",
    "test": "npm run test:central-egp && npm run test:producer && npm run test:tor && npm run test:auth && npm run test:user && npm run test:homepage && npm run test:report && npm run test:admin && npm run test:category",
    "test:queue-upsert": "tsx src/scripts/test-ingestion-queue.ts",
    "test:central-egp": "tsx --test src/modules/ingestion/adapters/central-egp.adapters.test.ts",
    "test:producer": "tsx --test src/apps/queue-producer/queue-producer.test.ts src/modules/ingestion/adapters/egp-announcement-discovery.adapter.test.ts src/modules/ingestion/adapters/bma-discovery.adapter.test.ts",
    "test:tor": "tsx --test src/modules/tor/tor.model.test.ts src/modules/tor/tor.repository.test.ts src/modules/tor/tor.controller.test.ts src/modules/ingestion/ingestion-job.repository.test.ts src/modules/ingestion/ingestion-report.test.ts src/modules/ingestion/thai-date.test.ts src/modules/ingestion/egp-submit-deadline.test.ts src/modules/ingestion/missing-tor-repair.test.ts src/modules/ingestion/central-egp-details-backfill.test.ts src/modules/ingestion/extraction/deepseek-tor-extractor.test.ts src/modules/ingestion/extraction/gemini-tor-extractor.test.ts",
    "test:auth": "tsx --test src/modules/auth/auth.routes.test.ts src/modules/auth/auth.config.test.ts src/scripts/dev-session-token.test.ts",
    "test:user": "tsx --test src/modules/user/user-bookmark.model.test.ts src/modules/user/user.repository.test.ts src/modules/user/user.routes.test.ts",
    "test:homepage": "tsx --test src/modules/tor/tor.controller.test.ts && tsx --test src/modules/homepage/homepage.routes.test.ts && tsx --test src/modules/tor/tor.routes.test.ts",
    "test:report": "tsx --test src/modules/report/report.controller.test.ts",
    "test:admin": "tsx --test src/modules/admin/audit-log.repository.test.ts src/modules/admin/admin.routes.test.ts src/modules/admin/admin.categories.routes.test.ts src/scripts/migrate-legacy-data.test.ts",
    "test:category": "tsx --test src/modules/category/category.repository.test.ts src/modules/category/category.routes.test.ts src/scripts/migrate-categories.test.ts",
    "migrate:categories": "tsx src/scripts/migrate-categories.ts",
    "migrate:legacy-data": "tsx src/scripts/migrate-legacy-data.ts",
    "dev:token": "tsx src/scripts/dev-session-token.ts",
    "dev:simulate-reingest": "tsx src/scripts/dev-simulate-reingest.ts",
    "seed:mock": "tsx src/scripts/seed-homepage-tors.ts && tsx src/scripts/seed-procurement-reports.ts",
    "seed:categories": "tsx src/scripts/seed-categories.ts",
    "backfill:deadlines": "tsx src/scripts/backfill-deadlines.ts",
    "requeue:jobs": "tsx src/scripts/requeue-jobs.ts",
    "report:job-failures": "tsx src/scripts/report-job-failures.ts",
    "repair:missing-tors": "tsx src/scripts/repair-missing-tors.ts",
    "backfill:egp-details": "tsx src/scripts/backfill-central-egp-details.ts",
    "set-admin": "tsx src/scripts/set-admin.ts",
    "sandbox:egp": "tsx src/scripts/sandbox-egp-announcements.ts",
    "discover:egp": "tsx src/scripts/discover-egp-announcements.ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Doggo-CSP/TORPulse.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Doggo-CSP/TORPulse/issues"
  },
  "homepage": "https://github.com/Doggo-CSP/TORPulse#readme",
  "description": "",
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@opendataloader/pdf": "^2.5.5",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "fflate": "^0.8.3",
    "mongoose": "^9.9.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.1",
    "@types/node": "^26.1.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  }
}
